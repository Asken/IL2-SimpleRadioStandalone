@page "/login"
@layout EmptyLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@inject AdminAuthOptions AuthOptions
@inject NavigationManager Navigation

<PageTitle>Log in · IL2-SRS Server</PageTitle>

<main class="login">
    <form method="post" action="account/login" class="login-card" novalidate>
        <AntiforgeryToken />
        <div class="brand">
            <img src="favicon.ico" alt="" width="28" height="28" />
            <h1>IL2-SRS Server</h1>
        </div>
        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
        <div class="form-field">
            <label for="password">Admin password</label>
            <input id="password" type="password" name="password" autocomplete="current-password" autofocus
                   aria-invalid="@FieldError.Invalid(PasswordError)"
                   aria-describedby="@FieldError.DescribedBy("password-error", PasswordError)" />
            <FieldError Id="password-error" Message="@PasswordError" />
        </div>
        <button type="submit" class="btn btn-primary">Log in</button>
    </form>
</main>

@code {
    [SupplyParameterFromQuery] private string ReturnUrl { get; set; }
    [SupplyParameterFromQuery] private string Error { get; set; }

    private string PasswordError => Error switch
    {
        null => null,
        "empty" => "Enter the admin password.",
        _ => "Incorrect password."
    };

    protected override void OnInitialized()
    {
        if (AuthOptions.Disabled)
        {
            Navigation.NavigateTo("/");
        }
    }
}
